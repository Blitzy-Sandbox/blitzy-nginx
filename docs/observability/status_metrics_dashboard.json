{
  "__inputs": [
    {
      "name": "DS_METRICS",
      "label": "Metrics data source",
      "description": "Time-series data source (Prometheus-compatible) holding nginx status-code metrics scraped from an exporter or derived from access/error logs.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_METRICS}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Strict-mode validation failures",
        "expr": "changes(nginx_http_status_validation_failures_total{instance=~\"$instance\"}[1m]) > 0",
        "titleFormat": "invalid HTTP status emitted",
        "tagKeys": "request_id,status"
      }
    ]
  },
  "description": "Dashboard template for the NGINX HTTP status-code registry refactor (Rule 1 / Observability). Visualizes response counts by status class (1xx-5xx), strict-mode (--with-http_status_validation) validation failures, and the top status codes. Self-contained and environment-agnostic: it uses template variables for the data source and instance, and references generic metric names that an exporter or log-derived pipeline must supply (nginx-core has no native per-status-class metric; see status_codes_observability.md). Correlate individual events with the $request_id correlation id.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Status classes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Responses by status class (1xx-5xx)",
      "description": "Per-second rate of responses grouped by HTTP status class. nginx-core does not break these out (stub_status only reports connection states and accepts/handled/requests counters), so this panel relies on exporter/log-derived metrics labeled by class.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisLabel": "responses/s"
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "expr": "sum by (class) (rate(nginx_http_status_class_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Status class distribution",
      "description": "Share of responses by status class over the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "values": [
            "percent"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "expr": "sum by (class) (increase(nginx_http_status_class_total{instance=~\"$instance\"}[$__range]))",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Validation",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 101,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Strict-mode validation failures (total)",
      "description": "Count of invalid HTTP status codes rejected by ngx_http_status_set() under --with-http_status_validation. Each failure emits a single NGX_LOG_ERR \"invalid HTTP status %ui\" line and falls back to 500. In default builds this metric is always zero (validation compiled out).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "expr": "sum(increase(nginx_http_status_validation_failures_total{instance=~\"$instance\"}[$__range]))",
          "legendFormat": "validation failures",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Validation failure rate",
      "description": "Per-second rate of strict-mode validation failures. Sustained non-zero values indicate a module emitting out-of-registry status codes; correlate offending requests via the $request_id correlation id in error.log.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 10
      },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "axisLabel": "failures/s"
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "expr": "sum(rate(nginx_http_status_validation_failures_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "failures/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Top codes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 102,
      "panels": []
    },
    {
      "type": "table",
      "title": "Top status codes",
      "description": "The most frequently emitted individual status codes over the selected range, including nginx extension codes (444, 494-499). Reflects the $status access-log value aggregated per code.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 19
      },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "expr": "topk(15, sum by (status) (increase(nginx_http_status_code_total{instance=~\"$instance\"}[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Top status codes (bar)",
      "description": "Bar-gauge view of the top status codes for quick visual ranking.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 19
      },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "expr": "topk(10, sum by (status) (increase(nginx_http_status_code_total{instance=~\"$instance\"}[$__range])))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "nginx",
    "http-status",
    "observability",
    "rule-1"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_METRICS",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_METRICS}"
        },
        "query": "label_values(nginx_http_status_class_total, instance)",
        "current": {},
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      },
      {
        "name": "request_id",
        "label": "Request ID (correlation)",
        "description": "nginx $request_id correlation id (32-char). Use to pivot from a dashboard spike to the matching error.log/access.log lines.",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "timezone": "",
  "title": "NGINX HTTP Status Codes - Observability",
  "uid": "nginx-http-status-codes",
  "version": 1,
  "weekStart": ""
}
