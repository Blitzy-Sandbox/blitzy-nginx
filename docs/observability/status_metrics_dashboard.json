{
  "__comment": "Self-contained dashboard TEMPLATE for nginx HTTP status-class metrics produced by the ngx_http_status registry refactor. This is a template (no live datasource binding); wire ${DS_PROMETHEUS} to your metrics source. Counters are surfaced via a stub_status-style text endpoint and exported as the metric names referenced below. See docs/observability/observability.md.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "title": "nginx HTTP Status Class Metrics",
  "uid": "nginx-http-status-metrics",
  "tags": ["nginx", "http-status", "rfc9110", "observability"],
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {}
      },
      {
        "name": "request_id",
        "type": "textbox",
        "label": "Request ID ($request_id correlation)",
        "query": "",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Responses by Status Class (rate)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "legendFormat": "2xx", "expr": "rate(nginx_status_2xx_total[5m])" },
        { "refId": "B", "legendFormat": "3xx", "expr": "rate(nginx_status_3xx_total[5m])" },
        { "refId": "C", "legendFormat": "4xx", "expr": "rate(nginx_status_4xx_total[5m])" },
        { "refId": "D", "legendFormat": "5xx", "expr": "rate(nginx_status_5xx_total[5m])" }
      ]
    },
    {
      "id": 2,
      "title": "Total 2xx Responses",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [
        { "refId": "A", "legendFormat": "2xx", "expr": "nginx_status_2xx_total" }
      ]
    },
    {
      "id": 3,
      "title": "Total 3xx Responses",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [
        { "refId": "A", "legendFormat": "3xx", "expr": "nginx_status_3xx_total" }
      ]
    },
    {
      "id": 4,
      "title": "Total 4xx Responses",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "legendFormat": "4xx", "expr": "nginx_status_4xx_total" }
      ]
    },
    {
      "id": 5,
      "title": "Total 5xx Responses",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
      "targets": [
        { "refId": "A", "legendFormat": "5xx", "expr": "nginx_status_5xx_total" }
      ]
    },
    {
      "id": 6,
      "title": "RFC 9110 Validation Rejections (rate)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "refId": "A", "legendFormat": "validation rejections", "expr": "rate(nginx_status_validation_rejections_total[5m])" }
      ]
    },
    {
      "id": 7,
      "title": "Status Violations by Request ID ($request_id)",
      "type": "logs",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "{job=\"nginx\"} |= \"status validation\" | request_id=`$request_id`" }
      ]
    }
  ]
}
